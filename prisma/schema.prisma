datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Girl {
  id        Int    @id @default(autoincrement())
  girl_id   Int
  code_ref  String
  name      String
  age       String
  height    String
  weight    String
  bust      String
  rank_bust String?
  skill     String
  price     Int
  province  String
  p_number  Int
  city      String
  c_number  Int
  p_jd      String
  p_wd      String
  c_jd      String
  c_wd      String
  address   String
  vx        String
  qq        String
  xl        String
  yn        String
  phone     String
  remarks   String
  photo     String
  state_ref Int
  photo1    String
  photo2    String
  photo3    String
  photo4    String
  photo5    String
  photo6    String
  video1    String
  video2    String
  video     String
  api_url   String
  web_url   String
}
